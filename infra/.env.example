# TEAMCRM infra — пример переменных окружения.
# Реальный .env создаётся на сервере со сгенерированными секретами и НЕ коммитится.

# Адрес для бинда админ-портов (WireGuard interface). Только VPN-доступ.
ADMIN_BIND=10.8.0.1

# PostgreSQL (+pgvector)
POSTGRES_USER=teamcrm
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=teamcrm

# Redis
REDIS_PASSWORD=__CHANGE_ME__

# RabbitMQ
RABBITMQ_USER=teamcrm
RABBITMQ_PASSWORD=__CHANGE_ME__

# Организация-вендор: её сотрудники ведут службу заботы всего продукта (ТЗ-8).
# Достаточно одного из двух — номер организации или почта её владельца. Значение
# читается ОДИН раз при старте и запоминается флагом в базе; дальше состав техотдела
# меняется в консоли. Пусто — обращения принимает владелец организации, в которой они
# появились (запасной путь: без поддержки не остаётся никто).
PLATFORM_TENANT_ID=
PLATFORM_ADMIN_EMAIL=
