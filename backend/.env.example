# TEAMCRM backend — пример окружения (dev). Реальные значения — в .env (вне git).
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://teamcrm:teamcrm@crm-postgres:5432/teamcrm

# Redis (Socket.io adapter, presence, cache)
REDIS_URL=redis://:teamcrm@crm-redis:6379

# RabbitMQ (фоновые воркеры появятся на Этапе 2; URL закладываем сейчас)
RABBITMQ_URL=amqp://teamcrm:teamcrm@crm-rabbitmq:5672

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:5173
