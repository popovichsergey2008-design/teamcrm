# TEAMCRM backend — пример окружения (dev). Реальные значения — в .env (вне git).
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://teamcrm:teamcrm@crm-postgres:5432/teamcrm

# Redis (Socket.io adapter, presence, cache)
REDIS_URL=redis://:teamcrm@crm-redis:6379

# RabbitMQ (фоновые воркеры появятся на Этапе 2; URL закладываем сейчас)
RABBITMQ_URL=amqp://teamcrm:teamcrm@crm-rabbitmq:5672

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# CORS (frontend origin). Список через запятую — используется и REST, и socket.io (realtime).
# Боевой домен обязателен здесь, иначе socket.io отклонит handshake с этого origin.
CORS_ORIGIN=http://localhost:5173,https://teamsmrt.com,https://www.teamsmrt.com

# MinIO (объектное хранилище файлов — Enhancements v1, Этап A)
MINIO_ENDPOINT=http://crm-minio:9000
MINIO_ROOT_USER=teamcrm
MINIO_ROOT_PASSWORD=__CHANGE_ME__
MINIO_BUCKET=teamcrm

# Этап 2 — догоняющий тик пересчёта себестоимости (мс; 0 = выкл)
ECONOMICS_TICK_MS=60000

# Этап 3 — AI Standup. Без ключей используется детерминированный mock-провайдер.
# OPENAI_API_KEY=sk-...           # Whisper STT (голос → текст)
# ANTHROPIC_API_KEY=sk-ant-...    # парсер намерений (текст → JSON)
AI_PARSER_MODEL=claude-haiku-4-5
# TELEGRAM_BOT_TOKEN=...          # без токена бот не отправляет сообщения (no-op)
# TELEGRAM_WEBHOOK_SECRET=...     # если задан — webhook проверяет X-Telegram-Bot-Api-Secret-Token

# Этап 6 — созвоны (mediasoup SFU). Без этих настроек звонки просто недоступны,
# остальная CRM работает как обычно; состояние видно в GET /api/media/health.
MEDIASOUP_NUM_WORKERS=2
MEDIASOUP_LISTEN_IP=0.0.0.0
# ВНЕШНИЙ адрес сервера. За NAT обязателен: без него ICE-кандидаты указывают в пустоту
# и звонок «идёт», но звука нет.
# MEDIASOUP_ANNOUNCED_IP=<public-ip-of-server>
# Диапазон RTP-портов — должен быть открыт в ufw ровно этот, а не «всё на всякий случай»
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
# MEDIASOUP_DISABLED=1            # аварийно выключить медиа-слой, не трогая код
# TURN (coturn) для звонков через NAT. Без него сработают только прямые соединения.
# Учётные данные выдаются временные: coturn настраивается с use-auth-secret=<TURN_SECRET>.
# TURN_HOST=<public-ip-of-server>
# TURN_SECRET=__СГЕНЕРИРОВАТЬ__
# TURN_TTL_SEC=28800
